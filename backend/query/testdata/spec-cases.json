    { "name": "count by a field that cannot be counted by", "ok": false, "spec": { "subject": "events", "where": [], "group_by": "time", "limit": 0 } },
    { "name": "count relations by an event field", "ok": false, "spec": { "subject": "relations", "where": [], "group_by": "user", "limit": 0 } },

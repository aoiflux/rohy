    { "name": "an upper bound on occurrences", "ok": false, "spec": { "subject": "events", "where": [{ "field": "occurrences", "op": "lte", "value": "3" }], "group_by": "", "limit": 0 } },
    { "name": "a field twice", "ok": false, "spec": { "subject": "events", "where": [{ "field": "user", "op": "eq", "value": "a" }, { "field": "user", "op": "eq", "value": "b" }], "group_by": "", "limit": 0 } },
    { "name": "one end of a range twice", "ok": false, "spec": { "subject": "events", "where": [{ "field": "time", "op": "gte", "value": "2026-01-01T00:00:00Z" }, { "field": "time", "op": "gte", "value": "2026-01-02T00:00:00Z" }], "group_by": "", "limit": 0 } },
    { "name": "an empty value", "ok": false, "spec": { "subject": "events", "where": [{ "field": "user", "op": "eq", "value": "" }], "group_by": "", "limit": 0 } },
    { "name": "a value outside the enum", "ok": false, "spec": { "subject": "relations", "where": [{ "field": "created_by", "op": "eq", "value": "robot" }], "group_by": "", "limit": 0 } },

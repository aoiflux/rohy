    { "name": "occurrences", "ok": true, "spec": { "subject": "events", "where": [{ "field": "occurrences", "op": "gte", "value": "2" }], "group_by": "", "limit": 0 } },
    { "name": "undated only", "ok": true, "spec": { "subject": "events", "where": [{ "field": "undated", "op": "eq", "value": "only" }], "group_by": "", "limit": 0 } },
    { "name": "count events by id", "ok": true, "spec": { "subject": "events", "where": [], "group_by": "event_id", "limit": 0 } },
    { "name": "a rule's relations by algorithm", "ok": true, "spec": { "subject": "relations", "where": [{ "field": "rule_id", "op": "eq", "value": "process-ancestry" }], "group_by": "algorithm", "limit": 0 } },
    { "name": "relations at an event", "ok": true, "spec": { "subject": "relations", "where": [{ "field": "event", "op": "eq", "value": "42" }, { "field": "created_by", "op": "eq", "value": "user" }], "group_by": "", "limit": 0 } },
    { "name": "count relations by graph", "ok": true, "spec": { "subject": "relations", "where": [], "group_by": "graph_id", "limit": 0 } },

    { "name": "no subject", "ok": false, "spec": { "subject": "", "where": [], "group_by": "", "limit": 0 } },
    { "name": "an unknown subject", "ok": false, "spec": { "subject": "nodes", "where": [], "group_by": "", "limit": 0 } },

{
  "_comment": "Shared by backend/query (Validate) and frontend/src/lib/query/spec.js (checkSpec): both must accept exactly the specs marked ok. A case added here is a rule both sides must keep.",
  "cases": [
    { "name": "every event", "ok": true, "spec": { "subject": "events", "where": [], "group_by": "", "limit": 0 } },
    { "name": "every relation, the most rows", "ok": true, "spec": { "subject": "relations", "where": [], "group_by": "", "limit": 1000 } },
    { "name": "one user", "ok": true, "spec": { "subject": "events", "where": [{ "field": "user", "op": "eq", "value": "alice" }], "group_by": "", "limit": 50 } },
    { "name": "a time range", "ok": true, "spec": { "subject": "events", "where": [{ "field": "time", "op": "gte", "value": "2026-01-01T00:00:00Z" }, { "field": "time", "op": "lte", "value": "2026-01-02T00:00:00+01:00" }], "group_by": "", "limit": 0 } },
    { "name": "a fractional second", "ok": true, "spec": { "subject": "events", "where": [{ "field": "time", "op": "gte", "value": "2026-01-01T00:00:00.123456Z" }], "group_by": "", "limit": 0 } },

        {
          "key": "event_id",
          "label": "Event ID",
          "kind": "text",
          "ops": [
            "eq"
          ],
          "groupable": true
        },
        {
          "key": "provider",
          "label": "Provider",
          "kind": "text",
          "ops": [
            "eq"
          ],
          "groupable": true
        },

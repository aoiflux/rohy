          "key": "user",
          "label": "User",
          "kind": "text",
          "ops": [
            "eq"
          ],
          "groupable": true
        },
        {
          "key": "source_type",
          "label": "Source type",
          "kind": "enum",
          "ops": [
            "eq"
          ],
          "values": [
            "single_evtx_file",
            "multiple_evtx_files",
            "live_system",
            "sqlite_db",
            "sqlite_message_db"
          ],
          "groupable": true
        },
        {
          "key": "source_identifier",
          "label": "Source",
          "kind": "text",
          "ops": [
            "eq"
          ],
          "groupable": true,
          "help": "The file path or channel the event was read from, exactly."
        },
        {
          "key": "time",
          "label": "Time",
          "kind": "time",
          "ops": [
            "gte",
            "lte"
          ],
          "groupable": false,
          "help": "RFC 3339, for example 2026-01-31T09:00:00Z. Both ends are inclusive."
        },
        {
          "key": "text",
          "label": "Text",
          "kind": "text",
          "ops": [
            "contains"
          ],
          "groupable": false,
          "help": "Anywhere in the event's searchable text, ignoring case."
        },
        {
          "key": "occurrences",
          "label": "Occurrences",
          "kind": "number",
          "ops": [
            "gte"
          ],
          "groupable": false,
          "help": "How many copies of the event were collapsed into it."
        },
        {
          "key": "relations",
          "label": "Has relations",
          "kind": "enum",
          "ops": [
            "eq"
          ],
          "values": [
            "any",
            "system",
            "user"
          ],
          "groupable": false,
          "help": "any: some relation; system: one a rule made; user: one an analyst drew."
        },
        {
          "key": "undated",
          "label": "Undated events",
          "kind": "enum",
          "ops": [
            "eq"
          ],
          "values": [
            "include",
            "exclude",
            "only"
          ],
          "default": "include",
          "groupable": false,
          "help": "Events with no timestamp, redacted ones among them. Included unless you say otherwise."
        }
      ],

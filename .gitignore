frontend/node_modules
frontend/dist
.claude/
frontend/.vscode/
rohy-data/

# Build outputs. build/ itself holds the packaging assets and the platform Taskfiles, which are
# committed; the icons in it come from frontend/src/assets/logo.svg (tools/gen_icons.py), and an
# icon left out would ship Wails' placeholder mark without the build failing.
/bin/
/.task/
*.syso
# build-all.ps1 / build-all.sh release archives and their checksum manifest.
/artefacts/
# The .desktop file every Linux build writes (generate:dotdesktop, build/linux/Taskfile.yml).
/build/linux/rohy.desktop
# The WebView2 bootstrapper the NSIS installer task downloads.
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Outputs of the Wails v2 build, which wrote into build/.
/build/bin/
/build/artefacts/

# Python bytecode from tools/
__pycache__/
*.pyc

# tools/profile output (go run ./tools/profile)
/profiles/

# The VS Code extension package, built by npx @vscode/vsce package.
tools/rohy-vi/*.vsix
